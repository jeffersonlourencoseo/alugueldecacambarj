---
import { SITE_CONFIG } from '../data/config';

const waUrl = SITE_CONFIG.social.whatsapp;

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre/', label: 'Quem Somos' },
  { href: '/servicos/', label: 'Serviços' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contato/', label: 'Contato' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-concrete/95 backdrop-blur-md border-b border-safety/20">
  <div class="container mx-auto px-6 md:px-12">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="font-display text-3xl md:text-4xl text-safety tracking-widest uppercase focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg">
        CaçambaRápido
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegação principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-semibold uppercase tracking-widest text-pale/70 hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-2 py-1"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center rounded bg-safety px-5 py-2.5 text-sm font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete"
        >
          Solicitar Orçamento
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-safety hover:bg-concrete-light focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-safety/20 py-4 bg-concrete"
      role="navigation"
      aria-label="Menu mobile"
    >
      <nav class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-4 py-3 text-base font-medium text-pale/80 hover:bg-concrete-light hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete"
          >
            {link.label}
          </a>
        ))}
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center justify-center rounded bg-safety px-4 py-3 text-base font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors"
        >
          Solicitar Orçamento
        </a>
      </nav>
    </div>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('mobile-menu-btn');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function () {
        var isOpen = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    })();
  </script>
</header>
