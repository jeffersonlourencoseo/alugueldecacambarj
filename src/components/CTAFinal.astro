---
import { SITE_CONFIG } from '../data/config';

const waUrl = SITE_CONFIG.social.whatsapp;
const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
---

<section class="py-24 md:py-40 bg-safety relative overflow-hidden">
  <!-- Elementos decorativos escuros -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-0 w-64 h-64 bg-concrete/5 -rotate-12"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-concrete/5 rotate-12"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-concrete/10 rotate-45"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative">
    <div class="max-w-5xl mx-auto text-center">
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px w-12 bg-concrete/30"></div>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-concrete/60">Orçamento Grátis</span>
        <div class="h-px w-12 bg-concrete/30"></div>
      </div>

      <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-concrete uppercase leading-[0.9] mb-8">
        Não deixe o
        <br />
        entulho parar
        <br />
        sua obra
      </h2>

      <p class="text-lg md:text-xl text-concrete/70 mb-12 max-w-2xl mx-auto font-sans">
        Caçamba no local em até 24h. Orçamento grátis, sem compromisso e com preço justo.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 bg-green-600 px-8 py-5 text-base font-display uppercase tracking-wider text-white hover:bg-green-700 transition-colors shadow-xl shadow-green-600/20 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 focus:ring-offset-safety min-h-[56px]"
          aria-label="Conversar no WhatsApp"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Conversar no WhatsApp
        </a>

        <a
          href={telUrl}
          class="inline-flex items-center justify-center gap-3 bg-concrete px-8 py-5 text-base font-display uppercase tracking-wider text-safety hover:bg-concrete-light transition-colors shadow-xl shadow-concrete/20 focus:outline-none focus:ring-2 focus:ring-concrete focus:ring-offset-2 focus:ring-offset-safety min-h-[56px]"
          aria-label={`Ligar agora para ${SITE_CONFIG.phone}`}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Ligar Agora
        </a>
      </div>
    </div>
  </div>
</section>
