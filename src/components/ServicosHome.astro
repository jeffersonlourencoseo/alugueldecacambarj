---
import { getCollection } from 'astro:content';

const servicos = await getCollection('servicos');
const servicosHome = servicos.slice(0, 6);
---

<section id="servicos" class="py-24 md:py-32 bg-concrete relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-px bg-safety/10"></div>

  <div class="container mx-auto px-6 md:px-12 relative">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-12 bg-safety"></div>
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Nossos Equipamentos</span>
        </div>
        <h2 class="font-display text-5xl md:text-6xl text-pale uppercase leading-[0.95] mb-4">
          Caçambas de
          <span class="text-safety">entulho</span>
          para todo tipo de obra
        </h2>
        <p class="text-pale/50 text-lg">
          Aluguel de caçamba de entulho para pequenas reformas até grandes demolições. Escolha o tamanho ideal e receba no local.
        </p>
      </div>

      <a
        href="/servicos/"
        class="inline-flex items-center gap-2 text-safety font-display uppercase tracking-wider text-lg hover:text-pale transition-colors group flex-shrink-0"
      >
        Ver Todos
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicosHome.map((servico) => (
        <a
          href={`/servicos/${servico.slug}/`}
          class="group bg-concrete-light border border-steel p-8 md:p-10 hover:border-safety transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] flex flex-col"
        >
          <div class="flex items-start justify-between mb-6">
            <h3 class="font-display text-2xl md:text-3xl text-pale group-hover:text-safety transition-colors uppercase">
              {servico.data.title}
            </h3>
            <svg class="w-6 h-6 text-steel group-hover:text-safety transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </div>

          <p class="text-pale/50 mb-8 flex-grow text-sm leading-relaxed">{servico.data.description}</p>

          {servico.data.idealPara && (
            <div class="pt-6 border-t border-steel">
              <p class="text-xs font-bold text-pale/40 uppercase tracking-wider mb-3">Ideal para:</p>
              <div class="flex flex-wrap gap-2">
                {servico.data.idealPara.slice(0, 3).map((item) => (
                  <span class="inline-block border border-steel px-3 py-1 text-xs text-pale/60">{item}</span>
                ))}
              </div>
            </div>
          )}

          <div class="absolute top-0 left-0 w-1 h-0 bg-safety group-hover:h-full transition-all duration-500"></div>
        </a>
      ))}
    </div>
  </div>
</section>
