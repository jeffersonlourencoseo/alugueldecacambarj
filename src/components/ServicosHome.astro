---
import { getCollection } from 'astro:content';

const servicos = await getCollection('servicos');
const servicosHome = servicos.slice(0, 6);
---

<section id="servicos" class="py-24 md:py-32 bg-gray-50">
  <div class="container mx-auto px-6 md:px-12">
    <div class="max-w-3xl mx-auto mb-16 text-center">
      <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
        Nossos Equipamentos
      </span>

      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
        Caçambas para todo tipo de obra
      </h2>

      <p class="text-lg text-gray-600">
        Desde pequenas reformas residenciais até grandes demolições. Escolha o tamanho ideal e receba no local.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12 mb-12">
      {servicosHome.map((servico) => (
        <a
          href={`/servicos/${servico.slug}`}
          class="group rounded-2xl bg-white p-10 md:p-12 border border-gray-100 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col"
        >
          <div class="flex items-start justify-between mb-6">
            <h3 class="text-xl md:text-2xl font-bold text-gray-900 group-hover:text-secondary transition-colors">
              {servico.data.title}
            </h3>
            <svg class="w-6 h-6 text-gray-400 group-hover:text-secondary transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>

          <p class="text-gray-600 mb-6 flex-grow">{servico.data.description}</p>

          {servico.data.idealPara && (
            <div class="pt-6 border-t border-gray-100">
              <p class="text-sm font-semibold text-gray-500 mb-3">Ideal para:</p>
              <div class="flex flex-wrap gap-2">
                {servico.data.idealPara.slice(0, 3).map((item) => (
                  <span class="inline-block rounded-lg bg-gray-100 px-3 py-1 text-sm text-gray-700">{item}</span>
                ))}
              </div>
            </div>
          )}
        </a>
      ))}
    </div>

    <div class="text-center">
      <a
        href="/servicos"
        class="inline-flex items-center justify-center rounded-xl border-2 border-secondary px-8 py-4 text-base font-bold text-secondary hover:bg-secondary hover:text-white transition-colors"
      >
        Ver Todos os Equipamentos
      </a>
    </div>
  </div>
</section>
