---
const diferenciais = [
  {
    icone: `
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10">
        <rect x="6" y="20" width="36" height="20" rx="2"/>
        <path d="M12 20V14a4 4 0 014-4h16a4 4 0 014 4v6"/>
        <circle cx="14" cy="36" r="3"/>
        <circle cx="34" cy="36" r="3"/>
        <path d="M6 28h36"/>
        <path d="M22 10h4"/>
      </svg>
    `,
    titulo: 'Entrega em até 24h',
    descricao: 'Solicitou, entregamos. Caçamba na sua obra no mesmo dia ou no máximo em 24 horas úteis.',
  },
  {
    icone: `
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10">
        <path d="M14 8h20l4 6v26a2 2 0 01-2 2H12a2 2 0 01-2-2V14l4-6z"/>
        <path d="M16 8V4h16v4"/>
        <path d="M18 20h12"/>
        <path d="M18 28h8"/>
        <circle cx="34" cy="34" r="4"/>
        <path d="M36 34l1.5 1.5"/>
      </svg>
    `,
    titulo: 'Documentação em Dia',
    descricao: 'Licença ambiental, nota fiscal e certificado de destinação. Zero dor de cabeça com a fiscalização.',
  },
  {
    icone: `
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10">
        <path d="M8 14l16-8 16 8-16 8L8 14z"/>
        <path d="M8 24l16 8 16-8"/>
        <path d="M8 34l16 8 16-8"/>
        <path d="M24 22v20"/>
      </svg>
    `,
    titulo: 'Preço Justo e Fixo',
    descricao: 'Orçamento transparente, sem taxas escondidas. Você sabe exatamente quanto vai pagar.',
  },
  {
    icone: `
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10">
        <path d="M24 4L6 14v20l18 10 18-10V14L24 4z"/>
        <path d="M24 24l8-4"/>
        <path d="M24 24V14"/>
        <path d="M24 44V24"/>
        <path d="M16 20l8 4"/>
        <circle cx="24" cy="24" r="2" fill="currentColor"/>
      </svg>
    `,
    titulo: 'Descarte Correto',
    descricao: 'Seu entulho vai para aterros licenciados. Compromisso real com o meio ambiente e a lei.',
  },
];
---

<section class="py-24 md:py-32 bg-concrete-light relative overflow-hidden">
  <!-- Textura sutil -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

  <div class="container mx-auto px-6 md:px-12 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Coluna do título -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-12 bg-safety"></div>
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Por que escolher a gente</span>
        </div>
        <h2 class="font-display text-5xl md:text-6xl text-pale uppercase leading-[0.95] mb-6">
          Trabalho<br />sério.<br /><span class="text-safety">Resultado real.</span>
        </h2>
        <p class="text-pale/50 font-sans leading-relaxed">
          Não é só alugar uma caçamba de entulho. É ter tranquilidade, agilidade e a certeza de que o serviço será feito direito.
        </p>
      </div>

      <!-- Cards -->
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {diferenciais.map((item, i) => (
          <div
            class="group relative bg-concrete border border-steel p-8 md:p-10 hover:border-safety transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)]"
            style={`animation-delay: ${i * 150}ms`}
          >
            <div class="text-safety mb-6 group-hover:scale-110 transition-transform duration-300" set:html={item.icone} />
            <h3 class="font-display text-2xl text-pale uppercase tracking-wide mb-3">{item.titulo}</h3>
            <p class="text-pale/50 text-sm leading-relaxed font-sans">{item.descricao}</p>
            <div class="absolute top-0 left-0 w-1 h-0 bg-safety group-hover:h-full transition-all duration-500"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
