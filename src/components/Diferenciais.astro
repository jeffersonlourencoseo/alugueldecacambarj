---
const diferenciais = [
  {
    icone: '⚡',
    titulo: 'Entrega em até 24h',
    descricao: 'Solicitou, entregamos. Caçamba na sua obra no mesmo dia ou no máximo em 24 horas úteis.',
  },
  {
    icone: '📋',
    titulo: 'Documentação em Dia',
    descricao: 'Licença ambiental, nota fiscal e certificado de destinação. Zero dor de cabeça com a fiscalização.',
  },
  {
    icone: '💰',
    titulo: 'Preço Justo e Fixo',
    descricao: 'Orçamento transparente, sem taxas escondidas. Você sabe exatamente quanto vai pagar.',
  },
  {
    icone: '🛡️',
    titulo: 'Descarte Correto',
    descricao: 'Seu entulho vai para aterros licenciados. Compromisso real com o meio ambiente e a lei.',
  },
];
---

<section class="py-24 md:py-32 bg-white">
  <div class="container mx-auto px-6 md:px-12">
    <div class="max-w-3xl mx-auto mb-16 text-center">
      <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
        Por que somos líderes
      </span>

      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
        Por que somos a escolha certa para sua obra
      </h2>

      <p class="text-lg text-gray-600">
        Não é só alugar uma caçamba. É ter tranquilidade, agilidade e a certeza de que o serviço será feito direito.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      {diferenciais.map((item) => (
        <div class="rounded-2xl bg-gray-50 p-10 md:p-12 border border-gray-100 text-center hover:bg-white hover:shadow-xl hover:border-transparent transition-all">
          <div class="text-4xl mb-6">{item.icone}</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{item.titulo}</h3>
          <p class="text-gray-600 leading-relaxed">{item.descricao}</p>
        </div>
      ))}
    </div>
  </div>
</section>
