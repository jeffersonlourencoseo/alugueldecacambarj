---
import { SITE_CONFIG } from '../data/config';

const waUrl = SITE_CONFIG.social.whatsapp;
---

<section class="relative overflow-hidden bg-concrete pt-32 pb-24 md:pt-48 md:pb-40">
  <!-- Faixa diagonal de segurança -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/4 -right-1/4 w-[80vw] h-[120vh] bg-safety/5 rotate-12 rounded-3xl"></div>
    <div class="absolute top-1/3 -left-20 w-2 h-64 bg-safety/30 rotate-45"></div>
    <div class="absolute bottom-20 right-10 w-24 h-24 border-2 border-safety/20 rotate-12"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative">
    <div class="max-w-5xl">
      <!-- Tag -->
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px w-12 bg-safety"></div>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">
          Locação de Caçambas — Rio de Janeiro
        </span>
      </div>

      <!-- Título principal -->
      <h1 class="font-display text-6xl md:text-8xl lg:text-9xl leading-[0.9] text-pale uppercase tracking-tight mb-8">
        Aluguel de
        <br />
        <span class="text-safety">Caçamba</span>
        <br />
        de Entulho
      </h1>

      <p class="text-lg md:text-xl text-pale/60 max-w-xl mb-10 font-sans leading-relaxed">
        {SITE_CONFIG.description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 bg-green-500 px-8 py-4 text-base font-display uppercase tracking-wider text-white hover:bg-green-600 transition-colors shadow-lg shadow-green-500/20 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:ring-offset-concrete min-h-[56px]"
          aria-label="Solicitar orçamento pelo WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp — Orçamento Rápido
        </a>

        <a
          href="/servicos/"
          class="inline-flex items-center justify-center gap-3 border-2 border-safety px-8 py-4 text-base font-display uppercase tracking-wider text-safety hover:bg-safety hover:text-concrete transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete min-h-[56px]"
        >
          Ver Equipamentos
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- NAP strip no fundo -->
  <div class="absolute bottom-0 left-0 right-0 border-t border-pale/10 bg-concrete/80 backdrop-blur-sm">
    <div class="container mx-auto px-6 md:px-12 py-3 flex flex-wrap items-center justify-between gap-4">
      <span class="text-xs text-pale/50 uppercase tracking-wider font-sans">📍 {SITE_CONFIG.address.addressLocality} — {SITE_CONFIG.address.addressRegion}</span>
      <span class="text-xs text-pale/50 uppercase tracking-wider font-sans">📞 {SITE_CONFIG.phone}</span>
      <span class="text-xs text-pale/50 uppercase tracking-wider font-sans">🕐 Seg–Sex 7h–18h | Sáb 8h–12h</span>
    </div>
  </div>
</section>
