---
import { SITE_CONFIG } from '../data/config';

const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
const waUrl = SITE_CONFIG.social.whatsapp;
---

<footer id="contato" class="bg-accent text-white pt-24 pb-12">
  <div class="container mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="text-2xl font-bold text-primary mb-4 block focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg">
          {SITE_CONFIG.name}
        </a>
        <p class="text-gray-400 leading-relaxed">
          {SITE_CONFIG.description}
        </p>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6">Navegação</h4>
        <ul class="space-y-3 text-gray-400">
          <li><a href="/" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Início</a></li>
          <li><a href="/sobre" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Sobre</a></li>
          <li><a href="/servicos" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Serviços</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Blog</a></li>
          <li><a href="/contato" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Contato</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6">Contato</h4>
        <ul class="space-y-3 text-gray-400">
          <li><a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">📞 {SITE_CONFIG.phone}</a></li>
          <li><a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-white transition-colors">✉️ {SITE_CONFIG.email}</a></li>
          <li>📍 {SITE_CONFIG.address.addressLocality} - {SITE_CONFIG.address.addressRegion}</li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6">Horário de Atendimento</h4>
        <ul class="space-y-3 text-gray-400">
          <li>Segunda a Sexta: 7h às 18h</li>
          <li>Sábado: 8h às 12h</li>
          <li>Emergências: 24h</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        © {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.
      </p>

      <div class="flex gap-6 text-sm text-gray-500">
        <a href="/privacidade" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Política de Privacidade</a>
        <a href="/termos" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-accent rounded-lg px-1">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
