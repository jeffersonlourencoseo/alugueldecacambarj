---
import { SITE_CONFIG } from '../data/config';

const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
const waUrl = SITE_CONFIG.social.whatsapp;
---

<footer id="contato" class="bg-concrete text-pale pt-20 pb-12 border-t-2 border-safety">
  <div class="container mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="font-display text-3xl text-safety tracking-widest uppercase mb-4 block focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg">
          {SITE_CONFIG.name}
        </a>
        <p class="text-pale/50 leading-relaxed text-sm">
          {SITE_CONFIG.description}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-safety mb-6">Navegação</h3>
        <ul class="space-y-3 text-pale/50 text-sm">
          <li><a href="/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Início</a></li>
          <li><a href="/sobre/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Quem Somos</a></li>
          <li><a href="/servicos/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Serviços</a></li>
          <li><a href="/blog/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Blog</a></li>
          <li><a href="/contato/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Contato</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-safety mb-6">Contato</h3>
        <ul class="space-y-3 text-pale/50 text-sm">
          <li><a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-safety transition-colors">📞 {SITE_CONFIG.phone}</a></li>
          <li><a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-safety transition-colors">✉️ {SITE_CONFIG.email}</a></li>
          <li class="text-pale/50">📍 {SITE_CONFIG.address.addressLocality} — {SITE_CONFIG.address.addressRegion}</li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-safety mb-6">Horário</h3>
        <ul class="space-y-3 text-pale/50 text-sm">
          <li>Segunda a Sexta: 7h às 18h</li>
          <li>Sábado: 8h às 12h</li>
          <li>Emergências: 24h</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-steel pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-pale/60 uppercase tracking-wider">
        © {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.
      </p>

      <div class="flex gap-6 text-xs text-pale/60 uppercase tracking-wider">
        <a href="/privacidade/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Política de Privacidade</a>
        <a href="/termos/" class="hover:text-safety transition-colors focus:outline-none focus:ring-2 focus:ring-safety focus:ring-offset-2 focus:ring-offset-concrete rounded-lg px-1">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
