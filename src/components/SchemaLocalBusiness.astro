---
import { SITE_CONFIG } from '../data/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_CONFIG.domain}/#business`,
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: SITE_CONFIG.domain,
  telephone: SITE_CONFIG.phoneRaw,
  email: SITE_CONFIG.email,
  priceRange: '$$',
  image: `${SITE_CONFIG.domain}${SITE_CONFIG.ogImage}`,

  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_CONFIG.address.streetAddress,
    addressLocality: SITE_CONFIG.address.addressLocality,
    addressRegion: SITE_CONFIG.address.addressRegion,
    postalCode: SITE_CONFIG.address.postalCode,
    addressCountry: SITE_CONFIG.address.addressCountry,
  },

  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE_CONFIG.geo.latitude,
    longitude: SITE_CONFIG.geo.longitude,
  },

  openingHoursSpecification: SITE_CONFIG.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${h.day}`,
    opens: h.opens,
    closes: h.closes,
  })),

  areaServed: {
    '@type': 'City',
    name: 'Rio de Janeiro',
    '@id': 'https://www.wikidata.org/wiki/Q8678',
  },

  serviceType: [
    'Aluguel de Caçamba de Entulho',
    'Locação de Caçamba de Entulho',
    'Retirada e Descarte de Entulho',
    'Aluguel de Caçambas Estacionárias',
    'Locação de Equipamentos para Construção Civil',
  ],

  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços de Locação',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Caçamba de Entulho 3m³',
          description: 'Aluguel de caçamba de entulho de 3m³ para pequenas reformas e limpezas.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Caçamba de Entulho 5m³',
          description: 'Aluguel de caçamba de entulho de 5m³ para obras médias e reformas comerciais.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Caçamba de Entulho 7m³',
          description: 'Aluguel de caçamba de entulho de 7m³ para grandes demolições e construções.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Retirada de Entulho',
          description: 'Remoção, coleta e descarte correto de entulho com documentação ambiental.',
        },
      },
    ],
  },

  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '127',
    bestRating: '5',
    worstRating: '1',
  },

  sameAs: [SITE_CONFIG.social.whatsapp].filter(Boolean),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
