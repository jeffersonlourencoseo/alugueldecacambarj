---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const postsRecentes = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<section id="blog" class="py-24 md:py-32 bg-gray-50">
  <div class="container mx-auto px-6 md:px-12">
    <div class="max-w-3xl mx-auto mb-16 text-center">
      <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
        Blog
      </span>

      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
        Dicas e Novidades
      </h2>

      <p class="text-lg text-gray-600">
        Conteúdo prático para quem trabalha com obras, reformas e construção civil.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12 mb-12">
      {postsRecentes.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group rounded-2xl bg-white p-8 md:p-10 border border-gray-100 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col"
        >
          <div class="flex flex-wrap items-center gap-3 mb-4">
            {post.data.tags?.slice(0, 2).map((tag) => (
              <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-secondary">
                {tag}
              </span>
            ))}
          </div>

          <h3 class="text-xl font-bold text-gray-900 group-hover:text-secondary transition-colors mb-3 leading-snug">
            {post.data.title}
          </h3>

          <p class="text-gray-600 text-sm leading-relaxed mb-6 flex-grow">
            {post.data.description}
          </p>

          <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
            <span>{post.data.author}</span>
            <span>
              {post.data.pubDate.toLocaleDateString('pt-BR', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })}
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center">
      <a
        href="/blog"
        class="inline-flex items-center justify-center rounded-xl border-2 border-secondary px-8 py-4 text-base font-bold text-secondary hover:bg-secondary hover:text-white transition-colors"
      >
        Ver Todos os Artigos
      </a>
    </div>
  </div>
</section>
