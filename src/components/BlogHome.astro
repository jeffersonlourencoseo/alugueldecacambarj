---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const postsRecentes = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<section id="blog" class="py-24 md:py-32 bg-concrete-light relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-px bg-safety/10"></div>

  <div class="container mx-auto px-6 md:px-12 relative">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-12 bg-safety"></div>
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Blog</span>
        </div>
        <h2 class="font-display text-5xl md:text-6xl text-pale uppercase leading-[0.95] mb-4">
          Dicas e
          <span class="text-safety">novidades</span>
        </h2>
        <p class="text-pale/50 text-lg">
          Conteúdo prático para quem trabalha com obras, reformas e construção civil.
        </p>
      </div>

      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-safety font-display uppercase tracking-wider text-lg hover:text-pale transition-colors group flex-shrink-0"
      >
        Ver Todos os Artigos
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {postsRecentes.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="group bg-concrete border border-steel p-8 md:p-10 hover:border-safety transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] flex flex-col"
        >
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class="text-xs font-bold text-safety uppercase tracking-wider">
              {post.data.pubDate.toLocaleDateString('pt-BR', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })}
            </span>
            {post.data.tags?.slice(0, 2).map((tag) => (
              <span class="text-xs text-pale/70 uppercase tracking-wider">{tag}</span>
            ))}
          </div>

          <h3 class="font-display text-2xl text-pale group-hover:text-safety transition-colors uppercase mb-4 leading-snug">
            {post.data.title}
          </h3>

          <p class="text-pale/50 text-sm leading-relaxed flex-grow">{post.data.description}</p>

          <div class="pt-6 mt-6 border-t border-steel flex items-center justify-between">
            <span class="text-xs text-pale/70 uppercase tracking-wider">{post.data.author}</span>
            <svg class="w-5 h-5 text-steel group-hover:text-safety transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
