---
import SEO from '../components/SEO.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import '../styles/fonts.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} />

    <!-- Preconnect para recursos de terceiros carregados após a renderização -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) — carregamento adiado para não bloquear a thread principal -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4K0HJKMNWB', {
        send_page_view: false,
        transport_type: 'beacon'
      });

      function loadGtag() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-4K0HJKMNWB';
        document.head.appendChild(s);
        gtag('event', 'page_view', {
          send_to: 'G-4K0HJKMNWB'
        });
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGtag, { timeout: 2000 });
      } else {
        window.addEventListener('load', loadGtag);
      }
    </script>
  </head>
  <body class="font-sans antialiased text-pale bg-concrete">
    <WhatsAppBtn />
    <slot />

    <!-- Rastreamento de cliques em telefone e WhatsApp (eventos GA4) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var evento = null;
        if (href.indexOf('tel:') === 0) evento = 'click_telefone';
        else if (href.indexOf('wa.me/') !== -1 || href.indexOf('api.whatsapp.com') !== -1) evento = 'click_whatsapp';
        if (!evento) return;
        gtag('event', evento, {
          send_to: 'G-4K0HJKMNWB',
          link_url: href.split('?')[0],
          link_text: (a.textContent || '').trim().slice(0, 60),
          page_path: location.pathname,
          transport_type: 'beacon'
        });
      }, true);
    </script>
  </body>
</html>
