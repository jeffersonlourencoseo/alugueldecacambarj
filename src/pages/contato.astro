---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormularioContato from '../components/FormularioContato.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE_CONFIG } from '../data/config';

const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
---

<Layout
  title={`Contato | Solicite um Orçamento - ${SITE_CONFIG.name}`}
  description="Fale com a CaçambaRápido. Orçamento grátis em 30 minutos. Atendimento por WhatsApp, telefone ou formulário."
>
  <Header />

  <main>
    <!-- NAP + Hero de Contato -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
            Fale Conosco
          </span>

          <h1 class="text-4xl md:text-6xl font-black leading-tight text-gray-900 mb-6">
            Solicite Seu Orçamento
          </h1>

          <p class="text-lg text-gray-600">
            Preencha o formulário, fale pelo WhatsApp ou ligue direto.
            Responderemos em até 30 minutos com o melhor preço da região.
          </p>
        </div>

        <!-- NAP (Nome, Endereço, Telefone) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">📍</div>
            <h3 class="font-bold text-gray-900 mb-1">{SITE_CONFIG.name}</h3>
            <p class="text-gray-600">{SITE_CONFIG.address.streetAddress} — {SITE_CONFIG.address.addressLocality}, {SITE_CONFIG.address.addressRegion}</p>
          </div>

          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">📞</div>
            <h3 class="font-bold text-gray-900 mb-1">Telefone / WhatsApp</h3>
            <p class="text-gray-600">{SITE_CONFIG.phone}</p>
          </div>

          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">🕐</div>
            <h3 class="font-bold text-gray-900 mb-1">Horário de Atendimento</h3>
            <p class="text-gray-600">Seg-Sex: 7h às 18h | Sáb: 8h às 12h</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-12 max-w-6xl mx-auto">
          <div class="lg:col-span-3">
            <FormularioContato variant="page" />
          </div>

          <div class="lg:col-span-2 space-y-8">
            <div class="rounded-2xl bg-secondary p-8 md:p-10 text-white">
              <h3 class="text-xl font-bold mb-4">Atendimento Imediato</h3>
              <p class="text-blue-100 mb-6">
                Prefere falar pelo WhatsApp? Clique no botão abaixo e envie sua solicitação agora mesmo.
              </p>
              <WhatsAppButton posicao="inline" />
            </div>

            <div class="rounded-2xl bg-green-50 p-8 md:p-10 border border-green-100">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Ligar Agora</h3>
              <p class="text-gray-600 mb-6">
                Atendimento rápido por telefone. Fale direto com nossa equipe.
              </p>
              <a
                href={telUrl}
                class="inline-flex items-center justify-center gap-3 rounded-xl bg-green-500 px-6 py-4 text-base font-bold text-white hover:bg-green-600 transition-colors w-full focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 min-h-[56px]"
                aria-label={`Ligar para ${SITE_CONFIG.phone}`}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {SITE_CONFIG.phone}
              </a>
            </div>

            <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Informações de Contato</h3>
              <ul class="space-y-4 text-gray-600">
                <li class="flex items-start gap-3">
                  <span class="text-xl">📧</span>
                  <div>
                    <p class="font-semibold text-gray-900">E-mail</p>
                    <p>{SITE_CONFIG.email}</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">🚛</span>
                  <div>
                    <p class="font-semibold text-gray-900">Cobertura</p>
                    <p>Região Metropolitana de {SITE_CONFIG.address.addressLocality}</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">⚡</span>
                  <div>
                    <p class="font-semibold text-gray-900">Emergências</p>
                    <p>Atendimento 24h para casos urgentes</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
