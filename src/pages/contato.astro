---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormularioContato from '../components/FormularioContato.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';

const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
---

<Layout
  title={`Orçamento de Aluguel de Caçamba de Entulho | ${SITE_CONFIG.name} RJ`}
  description="Solicite orçamento grátis de aluguel de caçamba de entulho no Rio de Janeiro. Atendimento em 30 minutos por WhatsApp, telefone ou formulário."
>
  <Header />

  <main>
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Contato', href: '/contato' },
      ]} />
    </div>

    <!-- Hero de Contato -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
            Fale Conosco
          </span>

          <h1 class="text-4xl md:text-6xl font-black leading-tight text-gray-900 mb-6">
            Orçamento de Aluguel de Caçamba de Entulho no Rio
          </h1>

          <p class="text-lg text-gray-600">
            Escolha a forma mais conveniente de falar conosco.
            Responderemos em até 30 minutos com o melhor preço da região.
          </p>
        </div>

        <!-- 1. CTA Principal: WhatsApp -->
        <div class="max-w-3xl mx-auto mb-12">
          <div class="rounded-2xl bg-green-500 p-8 md:p-12 text-white text-center shadow-xl shadow-green-500/20">
            <div class="text-5xl mb-4">💬</div>
            <h3 class="text-2xl md:text-3xl font-bold mb-4">Fale Conosco pelo WhatsApp</h3>
            <p class="text-green-100 mb-8 max-w-xl mx-auto">
              A forma mais rápida de tirar dúvidas e solicitar orçamento. Resposta em até 30 minutos.
            </p>
            <WhatsAppButton posicao="inline" />
          </div>
        </div>

        <!-- 2. CTA Secundário: Ligação -->
        <div class="max-w-3xl mx-auto mb-12">
          <div class="rounded-2xl bg-secondary p-8 md:p-12 text-white text-center">
            <div class="text-5xl mb-4">📞</div>
            <h3 class="text-2xl md:text-3xl font-bold mb-4">Prefere Ligar?</h3>
            <p class="text-blue-100 mb-8 max-w-xl mx-auto">
              Atendimento rápido por telefone. Fale direto com nossa equipe e receba seu orçamento.
            </p>
            <a
              href={telUrl}
              class="inline-flex items-center justify-center gap-3 rounded-xl bg-white px-8 py-5 text-base font-bold text-secondary hover:bg-gray-100 transition-colors shadow-lg focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 min-h-[56px]"
              aria-label={`Ligar para ${SITE_CONFIG.phone}`}
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {SITE_CONFIG.phone}
            </a>
          </div>
        </div>

        <!-- 3. Formulário -->
        <div class="max-w-3xl mx-auto mb-16">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Ou preencha o formulário</h3>
            <p class="text-gray-600">Responderemos em até 30 minutos via WhatsApp ou e-mail.</p>
          </div>
          <FormularioContato variant="page" />
        </div>

        <!-- 4. NAP (Nome, Endereço, Telefone) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">📍</div>
            <h3 class="font-bold text-gray-900 mb-1">{SITE_CONFIG.name}</h3>
            <p class="text-gray-600">{SITE_CONFIG.address.streetAddress} — {SITE_CONFIG.address.addressLocality}, {SITE_CONFIG.address.addressRegion}</p>
          </div>

          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">📞</div>
            <h3 class="font-bold text-gray-900 mb-1">Telefone / WhatsApp</h3>
            <p class="text-gray-600">{SITE_CONFIG.phone}</p>
          </div>

          <div class="rounded-2xl bg-gray-50 p-8 md:p-10 border border-gray-100 text-center">
            <div class="text-3xl mb-3">🕐</div>
            <h3 class="font-bold text-gray-900 mb-1">Horário de Atendimento</h3>
            <p class="text-gray-600">Seg-Sex: 7h às 18h | Sáb: 8h às 12h</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
