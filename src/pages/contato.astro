---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormularioContato from '../components/FormularioContato.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';

const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
const waUrl = SITE_CONFIG.social.whatsapp;
---

<Layout
  title={`Orçamento de Aluguel de Caçamba de Entulho | ${SITE_CONFIG.name} RJ`}
  description="Solicite orçamento grátis de aluguel de caçamba de entulho no Rio de Janeiro. Atendimento em 30 minutos por WhatsApp, telefone ou formulário."
>
  <Header />

  <main class="bg-concrete">
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Contato', href: '/contato/' },
      ]} />
    </div>

    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <div class="flex items-center justify-center gap-4 mb-6">
            <div class="h-px w-12 bg-safety"></div>
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Fale Conosco</span>
            <div class="h-px w-12 bg-safety"></div>
          </div>

          <h1 class="font-display text-5xl md:text-7xl text-pale uppercase leading-[0.95] mb-6">
            Orçamento de
            <br />
            <span class="text-safety">Caçamba</span> no Rio
          </h1>

          <p class="text-lg text-pale/50">
            Escolha a forma mais conveniente de falar conosco.
            Responderemos em até 30 minutos com o melhor preço da região.
          </p>
        </div>

        <!-- WhatsApp -->
        <div class="max-w-3xl mx-auto mb-12">
          <div class="bg-green-500 p-8 md:p-12 text-white text-center shadow-xl shadow-green-500/20 border border-green-400">
            <div class="font-display text-5xl mb-4">💬</div>
            <h3 class="font-display text-2xl md:text-3xl uppercase mb-4">Fale pelo WhatsApp</h3>
            <p class="text-green-100 mb-8 max-w-xl mx-auto">
              A forma mais rápida de tirar dúvidas e solicitar orçamento. Resposta em até 30 minutos.
            </p>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-white px-8 py-5 text-base font-display uppercase tracking-wider text-green-600 hover:bg-green-50 transition-colors shadow-lg min-h-[56px]"
            >
              WhatsApp — Orçamento Rápido
            </a>
          </div>
        </div>

        <!-- Telefone -->
        <div class="max-w-3xl mx-auto mb-12">
          <div class="bg-concrete-light border border-steel p-8 md:p-12 text-center">
            <div class="font-display text-5xl mb-4 text-pale">📞</div>
            <h3 class="font-display text-2xl md:text-3xl text-pale uppercase mb-4">Prefere Ligar?</h3>
            <p class="text-pale/50 mb-8 max-w-xl mx-auto">
              Atendimento rápido por telefone. Fale direto com nossa equipe e receba seu orçamento.
            </p>
            <a
              href={telUrl}
              class="inline-flex items-center justify-center gap-3 bg-safety px-8 py-5 text-base font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors shadow-lg min-h-[56px]"
              aria-label={`Ligar para ${SITE_CONFIG.phone}`}
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {SITE_CONFIG.phone}
            </a>
          </div>
        </div>

        <!-- Formulário -->
        <div class="max-w-3xl mx-auto mb-16">
          <div class="text-center mb-8">
            <h3 class="font-display text-2xl text-pale uppercase mb-2">Ou preencha o formulário</h3>
            <p class="text-pale/50">Responderemos em até 30 minutos via WhatsApp ou e-mail.</p>
          </div>
          <FormularioContato variant="page" />
        </div>

        <!-- NAP -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="bg-concrete-light border border-steel p-8 md:p-10 text-center">
            <div class="font-display text-3xl text-safety mb-3">📍</div>
            <h3 class="font-bold text-pale mb-1 text-sm uppercase tracking-wider">{SITE_CONFIG.name}</h3>
            <p class="text-pale/50 text-sm">{SITE_CONFIG.address.streetAddress} — {SITE_CONFIG.address.addressLocality}, {SITE_CONFIG.address.addressRegion}</p>
          </div>
          <div class="bg-concrete-light border border-steel p-8 md:p-10 text-center">
            <div class="font-display text-3xl text-safety mb-3">📞</div>
            <h3 class="font-bold text-pale mb-1 text-sm uppercase tracking-wider">Telefone / WhatsApp</h3>
            <p class="text-pale/50 text-sm">{SITE_CONFIG.phone}</p>
          </div>
          <div class="bg-concrete-light border border-steel p-8 md:p-10 text-center">
            <div class="font-display text-3xl text-safety mb-3">🕐</div>
            <h3 class="font-bold text-pale mb-1 text-sm uppercase tracking-wider">Horário</h3>
            <p class="text-pale/50 text-sm">Seg–Sex: 7h–18h | Sáb: 8h–12h</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
