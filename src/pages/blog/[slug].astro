---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaArticle from '../../components/SchemaArticle.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const todosPosts = await getCollection('blog');
const postsRelacionados = todosPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const autores: Record<string, { nome: string; bio: string; emoji: string; tipo: 'Organization' | 'Person'; cargo?: string }> = {
  'CaçambaRápido': {
    nome: 'CaçambaRápido',
    bio: 'Especialistas em locação de caçambas estacionárias e retirada de entulho no Rio de Janeiro. Mais de 15 anos de experiência e 500 obras atendidas.',
    emoji: '🚛',
    tipo: 'Organization',
  },
  'João Silva': {
    nome: 'João Silva',
    bio: 'Fundador e Diretor da CaçambaRápido. Mais de 15 anos no setor de locação.',
    emoji: '👨‍💼',
    tipo: 'Person',
    cargo: 'Fundador e Diretor',
  },
  'Ana Paula Costa': {
    nome: 'Ana Paula Costa',
    bio: 'Atendimento e Vendas na CaçambaRápido. Responde orçamentos em até 30 minutos.',
    emoji: '👩‍💼',
    tipo: 'Person',
    cargo: 'Atendimento e Vendas',
  },
  'Marcos Oliveira': {
    nome: 'Marcos Oliveira',
    bio: 'Logística e Operações na CaçambaRápido. Responsável por garantir que cada caçamba chegue no prazo certo.',
    emoji: '👨‍🔧',
    tipo: 'Person',
    cargo: 'Logística e Operações',
  },
};

const autorInfo = autores[post.data.author] || autores['CaçambaRápido'];
---

<Layout title={`${post.data.title} | Blog Aluguel de Caçamba de Entulho — ${SITE_CONFIG.name}`} description={post.data.description}>
  <Header />

  <main class="bg-concrete">
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Blog', href: '/blog/' },
        { label: post.data.title, href: `/blog/${post.slug}/` },
      ]} />
    </div>

    <SchemaArticle
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      author={autorInfo.nome}
      authorType={autorInfo.tipo}
      authorJobTitle={autorInfo.cargo}
      url={`${SITE_CONFIG.domain}/blog/${post.slug}/`}
      tags={post.data.tags}
    />

    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 lg:gap-12">
            <!-- Conteúdo -->
            <div class="lg:col-span-3">
              <a href="/blog/" class="inline-flex items-center gap-2 text-sm text-pale/70 hover:text-safety transition-colors mb-8">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Voltar para o blog
              </a>

              <header class="mb-12">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  {post.data.tags?.map((tag) => (
                    <span class="inline-block bg-safety/10 border border-safety/20 px-4 py-1 text-xs font-bold text-safety uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>

                <h1 class="font-display text-4xl md:text-5xl text-pale uppercase leading-tight mb-6">
                  {post.data.title}
                </h1>

                <div class="flex flex-wrap items-center gap-4 text-sm text-pale/70">
                  <span>Por <strong class="text-pale">{autorInfo.nome}</strong>{autorInfo.cargo ? ` — ${autorInfo.cargo}` : ''}</span>
                  <span>•</span>
                  <span>{post.data.pubDate.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                </div>
              </header>

              <article class="prose prose-lg prose-invert max-w-none text-pale/70">
                <Content />
              </article>

              <!-- CTA final -->
              <div class="mt-16 bg-safety p-8 md:p-10 text-concrete">
                <h3 class="font-display text-xl uppercase mb-4">Precisa de aluguel de caçamba de entulho?</h3>
                <p class="text-concrete/70 mb-6">
                  Tire suas dúvidas e solicite um orçamento sem compromisso. Atendemos em até 24h no Rio de Janeiro.
                </p>
                <a
                  href={SITE_CONFIG.social.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-3 bg-concrete px-6 py-3 text-sm font-display uppercase tracking-wider text-safety hover:bg-concrete-light transition-colors"
                >
                  WhatsApp — Orçamento Rápido
                </a>
              </div>

              <!-- Bio -->
              <div class="mt-12 bg-concrete-light border border-steel p-8">
                <div class="flex items-start gap-4">
                  <span class="font-display text-4xl text-safety">{autorInfo.emoji}</span>
                  <div>
                    <p class="font-bold text-pale">
                      Sobre {autorInfo.nome}
                      {autorInfo.cargo && <span class="text-sm font-normal text-pale/70 ml-2">{autorInfo.cargo}</span>}
                    </p>
                    <p class="text-pale/50 text-sm mt-1 leading-relaxed">{autorInfo.bio}</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
              <div class="sticky top-28 space-y-6">
                <div class="bg-concrete-light border border-steel p-8">
                  <h3 class="font-display text-lg text-pale uppercase mb-3">Orçamento Grátis</h3>
                  <p class="text-pale/50 text-sm mb-6">Resposta em 30 minutos pelo WhatsApp.</p>
                  <a
                    href={SITE_CONFIG.social.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 w-full bg-safety px-4 py-3 text-sm font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors"
                  >
                    WhatsApp
                  </a>
                </div>

                {postsRelacionados.length > 0 && (
                  <div class="bg-concrete-light border border-steel p-8">
                    <h3 class="font-display text-lg text-pale uppercase mb-6">Outras Dicas</h3>
                    <div class="space-y-6">
                      {postsRelacionados.map((rel) => (
                        <a href={`/blog/${rel.slug}/`} class="group block">
                          <p class="text-xs text-pale/70 mb-1">
                            {rel.data.pubDate.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' })}
                          </p>
                          <h4 class="font-display text-sm text-pale group-hover:text-safety transition-colors uppercase leading-snug">
                            {rel.data.title}
                          </h4>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="bg-concrete-light border border-steel p-8">
                  <h3 class="font-display text-lg text-pale uppercase mb-4">Serviços</h3>
                  <ul class="space-y-3 text-sm text-pale/50">
                    <li class="flex items-center gap-2"><svg class="w-4 h-4 text-safety" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Caçamba 3m³</li>
                    <li class="flex items-center gap-2"><svg class="w-4 h-4 text-safety" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Caçamba 5m³</li>
                    <li class="flex items-center gap-2"><svg class="w-4 h-4 text-safety" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Caçamba 7m³</li>
                    <li class="flex items-center gap-2"><svg class="w-4 h-4 text-safety" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Retirada de Entulho</li>
                  </ul>
                  <a href="/servicos/" class="inline-block mt-4 text-sm font-display uppercase tracking-wider text-safety hover:text-pale transition-colors">Ver todos →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
