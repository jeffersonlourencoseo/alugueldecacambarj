---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const todosPosts = await getCollection('blog');
const postsRelacionados = todosPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout title={`${post.data.title} | Blog ${SITE_CONFIG.name}`} description={post.data.description}>
  <Header />

  <main>
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 lg:gap-12">
            <!-- Conteúdo Principal -->
            <div class="lg:col-span-3">
              <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-secondary transition-colors mb-8">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Voltar para o blog
              </a>

              <header class="mb-12">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  {post.data.tags?.map((tag) => (
                    <span class="inline-block rounded-full bg-primary/10 px-4 py-1 text-xs font-bold text-secondary">
                      {tag}
                    </span>
                  ))}
                </div>

                <h1 class="text-4xl md:text-5xl font-black leading-tight text-gray-900 mb-6">
                  {post.data.title}
                </h1>

                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                  <span>Por <strong class="text-gray-900">{post.data.author}</strong></span>
                  <span>•</span>
                  <span>{post.data.pubDate.toLocaleDateString('pt-BR', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}</span>
                </div>
              </header>

              <article class="prose prose-lg max-w-none">
                <Content />
              </article>

              <!-- CTA no final do post -->
              <div class="mt-16 rounded-2xl bg-secondary p-8 md:p-10 text-white">
                <h3 class="text-xl font-bold mb-4">Precisa de uma caçamba para sua obra?</h3>
                <p class="text-blue-100 mb-6">
                  Tire suas dúvidas e solicite um orçamento sem compromisso. Atendemos em até 24h.
                </p>
                <WhatsAppButton posicao="inline" />
              </div>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
              <div class="sticky top-28 space-y-8">
                <!-- CTA Sidebar -->
                <div class="rounded-2xl bg-primary p-8 text-center">
                  <h3 class="text-lg font-bold text-accent mb-3">Orçamento Grátis</h3>
                  <p class="text-accent/80 text-sm mb-6">
                    Resposta em 30 minutos pelo WhatsApp.
                  </p>
                  <WhatsAppButton posicao="inline" />
                </div>

                <!-- Posts Relacionados -->
                {postsRelacionados.length > 0 && (
                  <div class="rounded-2xl bg-gray-50 p-8 border border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900 mb-6">Outras Dicas de Obra</h3>
                    <div class="space-y-6">
                      {postsRelacionados.map((rel) => (
                        <a href={`/blog/${rel.slug}`} class="group block">
                          <p class="text-xs text-gray-500 mb-1">
                            {rel.data.pubDate.toLocaleDateString('pt-BR', {
                              day: 'numeric',
                              month: 'short',
                              year: 'numeric',
                            })}
                          </p>
                          <h4 class="font-bold text-gray-900 group-hover:text-secondary transition-colors leading-snug">
                            {rel.data.title}
                          </h4>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Info rápida -->
                <div class="rounded-2xl bg-white p-8 border border-gray-100">
                  <h3 class="text-lg font-bold text-gray-900 mb-4">Serviços</h3>
                  <ul class="space-y-3 text-sm text-gray-600">
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      Caçamba 3m³
                    </li>
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      Caçamba 5m³
                    </li>
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      Caçamba 7m³
                    </li>
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      Retirada de Entulho
                    </li>
                  </ul>
                  <a href="/servicos" class="inline-block mt-4 text-sm font-bold text-secondary hover:underline">
                    Ver todos os serviços →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
