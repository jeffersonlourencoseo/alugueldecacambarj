---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Diferenciais from '../components/Diferenciais.astro';
import SobreResumo from '../components/SobreResumo.astro';
import ServicosHome from '../components/ServicosHome.astro';
import Depoimentos from '../components/Depoimentos.astro';
import BlogHome from '../components/BlogHome.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import SchemaFAQ from '../components/SchemaFAQ.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import { SITE_CONFIG } from '../data/config';

const faqItems = [
  {
    question: 'Quanto custa o aluguel de caçamba de entulho no Rio de Janeiro?',
    answer: 'O valor do aluguel de caçamba de entulho varia conforme o tamanho. A caçamba de 3m³ sai a partir de R$ 350, a de 5m³ a partir de R$ 450 e a de 7m³ a partir de R$ 600. Todos os valores incluem entrega, retirada e documentação ambiental. Solicite um orçamento grátis via WhatsApp em até 30 minutos.',
  },
  {
    question: 'Qual o prazo de entrega da caçamba de entulho?',
    answer: 'Entregamos caçambas de entulho no mesmo dia ou, no máximo, em até 24 horas úteis após a confirmação do pedido. Atendemos todas as regiões do Rio de Janeiro — RJ.',
  },
  {
    question: 'A caçamba de entulho inclui nota fiscal e licença ambiental?',
    answer: 'Sim. Todo aluguel de caçamba de entulho inclui nota fiscal, certificado de destinação de resíduos e comprovante de descarte em aterro licenciado. Você não tem dor de cabeça com fiscalização.',
  },
  {
    question: 'Como escolher o tamanho ideal de caçamba de entulho para minha obra?',
    answer: 'A caçamba de entulho de 3m³ é ideal para pequenas reformas e limpeza de terreno. A de 5m³ atende a maioria das obras médias e reformas comerciais. A de 7m³ é indicada para grandes demolições e construções. Tem dúvida? Fale conosco que orientamos.',
  },
  {
    question: 'Posso descartar qualquer tipo de entulho na caçamba?',
    answer: 'Aceitamos entulho de construção civil, madeira, metal, plástico, cerâmica e concreto na caçamba de entulho. Não são permitidos líquidos, produtos químicos, pilhas, baterias e materiais inflamáveis. Em caso de dúvida, consulte nossa equipe.',
  },
];
---

<Layout
  title={`Aluguel de Caçamba de Entulho no Rio de Janeiro | ${SITE_CONFIG.name} — RJ`}
  description={SITE_CONFIG.description}
>
  <Header />

  <main>
    <Hero />
    <Diferenciais />
    <SobreResumo />
    <ServicosHome />
    <Depoimentos />
    <BlogHome />

    <!-- Áreas de Atendimento — Local SEO -->
    <section class="py-24 md:py-32 bg-white" id="atendimento">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto mb-16 text-center">
          <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
            Atendimento em Todo o Rio
          </span>
          <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
            Caçamba para Toda a Cidade
          </h2>
          <p class="text-lg text-gray-600">
            Entregamos caçambas em todas as regiões do Rio de Janeiro. Escolha sua zona e veja os bairros atendidos com entrega rápida.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <a href="/area-de-atendimento/zona-norte/" class="group block rounded-2xl bg-gray-50 border border-gray-100 p-8 text-center hover:border-secondary hover:shadow-lg transition-all">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 text-green-700 mb-4 group-hover:bg-green-600 group-hover:text-white transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Zona Norte</h3>
            <p class="text-sm text-gray-600">Tijuca, Méier, Vila Isabel, Madureira e mais</p>
            <span class="inline-block mt-4 text-secondary font-semibold group-hover:text-blue-900">Ver bairros →</span>
          </a>

          <a href="/area-de-atendimento/zona-sul/" class="group block rounded-2xl bg-gray-50 border border-gray-100 p-8 text-center hover:border-secondary hover:shadow-lg transition-all">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 text-blue-700 mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Zona Sul</h3>
            <p class="text-sm text-gray-600">Copacabana, Ipanema, Botafogo, Flamengo e mais</p>
            <span class="inline-block mt-4 text-secondary font-semibold group-hover:text-blue-900">Ver bairros →</span>
          </a>

          <a href="/area-de-atendimento/zona-sudoeste/" class="group block rounded-2xl bg-gray-50 border border-gray-100 p-8 text-center hover:border-secondary hover:shadow-lg transition-all">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-100 text-amber-700 mb-4 group-hover:bg-amber-600 group-hover:text-white transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Zona Sudoeste</h3>
            <p class="text-sm text-gray-600">Barra da Tijuca, Recreio, Jacarepaguá, Freguesia e mais</p>
            <span class="inline-block mt-4 text-secondary font-semibold group-hover:text-blue-900">Ver bairros →</span>
          </a>
        </div>

        <div class="text-center mt-12">
          <p class="text-gray-500 text-sm mb-4">
            Quer ver a lista completa? Acesse a página de Área de Atendimento.
          </p>
          <a href="/area-de-atendimento/" class="inline-flex items-center justify-center rounded-xl bg-secondary px-8 py-4 text-base font-bold text-white hover:bg-blue-900 transition-colors">
            Ver Toda a Área de Atendimento
          </a>
        </div>
      </div>
    </section>

    {/* FAQ — otimizado para AI Overviews e featured snippets */}
    <section class="py-24 md:py-32 bg-gray-50" id="faq">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto mb-16 text-center">
          <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
            Dúvidas Frequentes
          </span>
          <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
            Perguntas e Respostas
          </h2>
          <p class="text-lg text-gray-600">
            Tudo o que você precisa saber antes de alugar sua caçamba.
          </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-6">
          {faqItems.map((faq) => (
            <details class="group rounded-2xl bg-white border border-gray-100 open:shadow-lg transition-all">
              <summary class="flex items-center justify-between cursor-pointer p-6 md:p-8 text-left hover:text-secondary transition-colors list-none">
                <h3 class="font-bold text-gray-900 text-lg">
                  {faq.question}
                </h3>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-6 md:px-8 pb-6 md:pb-8 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <SchemaFAQ items={faqItems} />
    <SchemaLocalBusiness />

    <CTAFinal />
  </main>

  <Footer />
</Layout>
