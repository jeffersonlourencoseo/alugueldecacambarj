---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((servico) => ({
    params: { slug: servico.slug },
    props: { servico },
  }));
}

interface Props {
  servico: CollectionEntry<'servicos'>;
}

const { servico } = Astro.props;
const { Content } = await servico.render();

const waMensagem = `Olá! Vi no site o serviço ${servico.data.title} e gostaria de um orçamento.`;
const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
---

<Layout title={`${servico.data.title} | ${SITE_CONFIG.name}`} description={servico.data.description}>
  <Header />

  <main>
    <!-- Hero do Serviço -->
    <section class="py-24 md:py-32 bg-gray-50">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <a href="/servicos" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-secondary transition-colors mb-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Voltar para serviços
          </a>

          <div class="mb-12">
            <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
              Serviço de Locação
            </span>

            <h1 class="text-4xl md:text-6xl font-black leading-tight text-gray-900 mb-6">
              {servico.data.title}
            </h1>

            <p class="text-xl text-gray-600 max-w-3xl">{servico.data.description}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Conteúdo Principal: Especificações + Benefícios -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
            <!-- Coluna principal com conteúdo -->
            <div class="lg:col-span-2">
              <article class="prose prose-lg max-w-none">
                <Content />
              </article>

              <!-- Benefícios / Aplicações -->
              {servico.data.idealPara && (
                <div class="mt-12 pt-12 border-t border-gray-200">
                  <h3 class="text-2xl font-bold text-gray-900 mb-6">Ideal para</h3>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {servico.data.idealPara.map((item) => (
                      <li class="flex items-center gap-3 rounded-xl bg-gray-50 px-5 py-4 border border-gray-100">
                        <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-gray-700">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Sidebar com Especificações e CTA -->
            <div class="lg:col-span-1">
              <div class="rounded-2xl bg-white p-8 md:p-10 border border-gray-100 shadow-sm sticky top-28">
                <h3 class="text-xl font-bold text-gray-900 mb-6">Especificações</h3>

                <ul class="space-y-4 mb-8">
                  {servico.data.capacidade && (
                    <li class="flex justify-between text-sm py-2 border-b border-gray-100">
                      <span class="text-gray-500">Capacidade</span>
                      <span class="font-semibold text-gray-900">{servico.data.capacidade}</span>
                    </li>
                  )}
                  <li class="flex justify-between text-sm py-2 border-b border-gray-100">
                    <span class="text-gray-500">Documentação</span>
                    <span class="font-semibold text-gray-900">Inclusa</span>
                  </li>
                  <li class="flex justify-between text-sm py-2 border-b border-gray-100">
                    <span class="text-gray-500">Prazo de Entrega</span>
                    <span class="font-semibold text-gray-900">Até 24h</span>
                  </li>
                  <li class="flex justify-between text-sm py-2">
                    <span class="text-gray-500">Atendimento</span>
                    <span class="font-semibold text-gray-900">Seg a Sáb</span>
                  </li>
                </ul>

                <div class="space-y-4">
                  <WhatsAppButton
                    posicao="inline"
                    mensagem={waMensagem}
                  />

                  <a
                    href={telUrl}
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-secondary px-6 py-4 text-base font-bold text-white hover:bg-blue-900 transition-colors w-full focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2 min-h-[56px]"
                    aria-label={`Ligar agora para ${SITE_CONFIG.phone}`}
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Ligar Agora
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA de Fechamento -->
    <section class="py-24 md:py-32 bg-primary">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-black text-accent mb-4">
            Pronto para locar sua {servico.data.title}?
          </h2>
          <p class="text-lg text-accent/80 mb-10 max-w-2xl mx-auto">
            Orçamento grátis em 30 minutos. Entrega rápida e documentação completa.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <WhatsAppButton posicao="inline" mensagem={waMensagem} />
            <a
              href={telUrl}
              class="inline-flex items-center justify-center gap-3 rounded-xl bg-accent px-8 py-5 text-base font-bold text-white hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 min-h-[56px]"
              aria-label={`Ligar agora para ${SITE_CONFIG.phone}`}
            >
              Ligar Agora
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
