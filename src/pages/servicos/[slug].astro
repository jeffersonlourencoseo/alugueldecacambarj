---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaService from '../../components/SchemaService.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((servico) => ({
    params: { slug: servico.slug },
    props: { servico },
  }));
}

interface Props {
  servico: CollectionEntry<'servicos'>;
}

const { servico } = Astro.props;
const { Content } = await servico.render();

const waMensagem = `Olá! Vi no site o serviço ${servico.data.title} e gostaria de um orçamento.`;
const waUrl = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(waMensagem)}`;
const telUrl = `tel:${SITE_CONFIG.phoneRaw}`;
---

<Layout title={`Aluguel de Caçamba de Entulho — ${servico.data.title} | ${SITE_CONFIG.name} RJ`} description={servico.data.description}>
  <Header />

  <main class="bg-concrete">
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Serviços', href: '/servicos/' },
        { label: servico.data.title, href: `/servicos/${servico.slug}/` },
      ]} />
    </div>

    <SchemaService
      title={servico.data.title}
      description={servico.data.description}
      url={`${SITE_CONFIG.domain}/servicos/${servico.slug}/`}
      price={servico.data.preco}
    />

    <!-- Hero -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <a href="/servicos/" class="inline-flex items-center gap-2 text-sm text-pale/70 hover:text-safety transition-colors mb-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Voltar para serviços
          </a>

          <div class="mb-12">
            <span class="inline-block bg-safety/10 border border-safety/20 px-4 py-2 text-xs font-bold text-safety uppercase tracking-wider mb-6">
              Serviço de Locação
            </span>

            <h1 class="font-display text-4xl md:text-6xl text-pale uppercase leading-tight mb-6">
              Aluguel de {servico.data.title} para Entulho
            </h1>

            <p class="text-xl text-pale/50 max-w-3xl">{servico.data.description} Locação com entrega rápida e documentação.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Conteúdo -->
    <section class="py-24 md:py-32 bg-concrete-light relative">
      <div class="absolute top-0 left-0 w-full h-px bg-safety/10"></div>
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
            <div class="lg:col-span-2">
              <article class="prose prose-lg prose-invert max-w-none text-pale/70">
                <Content />
              </article>

              {servico.data.idealPara && (
                <div class="mt-12 pt-12 border-t border-steel">
                  <h3 class="font-display text-2xl text-pale uppercase mb-6">Ideal para</h3>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {servico.data.idealPara.map((item) => (
                      <li class="flex items-center gap-3 bg-concrete border border-steel px-5 py-4">
                        <svg class="w-5 h-5 text-safety flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-pale/70">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
              <div class="bg-concrete border border-steel p-8 md:p-10 sticky top-28">
                <h3 class="font-display text-xl text-pale uppercase mb-6">Especificações</h3>

                <ul class="space-y-4 mb-8">
                  {servico.data.capacidade && (
                    <li class="flex justify-between text-sm py-2 border-b border-steel">
                      <span class="text-pale/70">Capacidade</span>
                      <span class="font-semibold text-pale">{servico.data.capacidade}</span>
                    </li>
                  )}
                  <li class="flex justify-between text-sm py-2 border-b border-steel">
                    <span class="text-pale/70">Documentação</span>
                    <span class="font-semibold text-pale">Inclusa</span>
                  </li>
                  <li class="flex justify-between text-sm py-2 border-b border-steel">
                    <span class="text-pale/70">Prazo de Entrega</span>
                    <span class="font-semibold text-pale">Até 24h</span>
                  </li>
                  <li class="flex justify-between text-sm py-2">
                    <span class="text-pale/70">Atendimento</span>
                    <span class="font-semibold text-pale">Seg a Sáb</span>
                  </li>
                </ul>

                <div class="space-y-4">
                  <a
                    href={waUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 w-full bg-green-500 px-6 py-4 text-base font-display uppercase tracking-wider text-white hover:bg-green-600 transition-colors min-h-[56px]"
                  >
                    WhatsApp
                  </a>

                  <a
                    href={telUrl}
                    class="inline-flex items-center justify-center gap-2 w-full bg-safety px-6 py-4 text-base font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors min-h-[56px]"
                    aria-label={`Ligar agora para ${SITE_CONFIG.phone}`}
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Ligar Agora
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Outros Serviços -->
    <section class="py-24 md:py-32 relative">
      <div class="absolute top-0 left-0 w-full h-px bg-safety/10"></div>
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="font-display text-3xl md:text-4xl text-pale uppercase mb-4">Outros Serviços</h2>
          <p class="text-lg text-pale/50">Encontre a caçamba ideal para o tamanho da sua obra.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/servicos/cacamba-3m3/" class={`border p-6 transition-all hover:border-safety hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] ${servico.slug === 'cacamba-3m3' ? 'bg-safety border-safety text-concrete' : 'bg-concrete-light border-steel'}`}>
            <h3 class={`font-display text-lg uppercase mb-1 ${servico.slug === 'cacamba-3m3' ? 'text-concrete' : 'text-pale'}`}>Caçamba 3m³</h3>
            <p class={`text-sm ${servico.slug === 'cacamba-3m3' ? 'text-concrete/70' : 'text-pale/50'}`}>Pequenas reformas</p>
          </a>
          <a href="/servicos/cacamba-5m3/" class={`border p-6 transition-all hover:border-safety hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] ${servico.slug === 'cacamba-5m3' ? 'bg-safety border-safety text-concrete' : 'bg-concrete-light border-steel'}`}>
            <h3 class={`font-display text-lg uppercase mb-1 ${servico.slug === 'cacamba-5m3' ? 'text-concrete' : 'text-pale'}`}>Caçamba 5m³</h3>
            <p class={`text-sm ${servico.slug === 'cacamba-5m3' ? 'text-concrete/70' : 'text-pale/50'}`}>Obras médias</p>
          </a>
          <a href="/servicos/cacamba-7m3/" class={`border p-6 transition-all hover:border-safety hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] ${servico.slug === 'cacamba-7m3' ? 'bg-safety border-safety text-concrete' : 'bg-concrete-light border-steel'}`}>
            <h3 class={`font-display text-lg uppercase mb-1 ${servico.slug === 'cacamba-7m3' ? 'text-concrete' : 'text-pale'}`}>Caçamba 7m³</h3>
            <p class={`text-sm ${servico.slug === 'cacamba-7m3' ? 'text-concrete/70' : 'text-pale/50'}`}>Grandes demolições</p>
          </a>
          <a href="/servicos/retirada-entulho/" class={`border p-6 transition-all hover:border-safety hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] ${servico.slug === 'retirada-entulho' ? 'bg-safety border-safety text-concrete' : 'bg-concrete-light border-steel'}`}>
            <h3 class={`font-display text-lg uppercase mb-1 ${servico.slug === 'retirada-entulho' ? 'text-concrete' : 'text-pale'}`}>Retirada</h3>
            <p class={`text-sm ${servico.slug === 'retirada-entulho' ? 'text-concrete/70' : 'text-pale/50'}`}>Remoção completa</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 md:py-32 bg-concrete-light relative">
      <div class="absolute top-0 left-0 w-full h-px bg-safety/10"></div>
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="font-display text-3xl md:text-4xl text-pale uppercase mb-4">
            Pronto para locar sua {servico.data.title}?
          </h2>
          <p class="text-lg text-pale/50 mb-10 max-w-2xl mx-auto">
            Orçamento grátis em 30 minutos. Entrega rápida e documentação completa.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-green-500 px-8 py-5 text-base font-display uppercase tracking-wider text-white hover:bg-green-600 transition-colors shadow-xl shadow-green-500/20 min-h-[56px]"
            >
              WhatsApp
            </a>
            <a
              href={telUrl}
              class="inline-flex items-center justify-center gap-3 bg-safety px-8 py-5 text-base font-display uppercase tracking-wider text-concrete hover:bg-safety-dark transition-colors min-h-[56px]"
            >
              Ligar Agora
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
