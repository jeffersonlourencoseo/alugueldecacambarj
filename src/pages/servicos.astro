---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';

const servicos = await getCollection('servicos');
---

<Layout
  title={`Aluguel de Caçamba de Entulho — 3m³, 5m³, 7m³ | ${SITE_CONFIG.name} RJ`}
  description="Aluguel de caçamba de entulho de 3m³, 5m³ e 7m³ no Rio de Janeiro. Locação com entrega rápida, retirada e documentação ambiental. Solicite orçamento grátis."
>
  <Header />

  <main class="bg-concrete">
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Serviços', href: '/servicos/' },
      ]} />
    </div>

    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mb-16">
          <div class="flex items-center gap-4 mb-6">
            <div class="h-px w-12 bg-safety"></div>
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Nossos Serviços</span>
          </div>

          <h1 class="font-display text-5xl md:text-7xl text-pale uppercase leading-[0.95] mb-6">
            Aluguel de
            <br />
            <span class="text-safety">Caçamba</span>
            <br />
            no Rio de Janeiro
          </h1>

          <p class="text-lg text-pale/50">
            Escolha o tamanho ideal de caçamba de entulho para sua obra. Todos incluem entrega, retirada e documentação ambiental.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {servicos.map((servico) => (
            <a
              href={`/servicos/${servico.slug}/`}
              class="group bg-concrete-light border border-steel p-10 md:p-12 hover:border-safety transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] flex flex-col"
            >
              <div class="flex items-start justify-between mb-6">
                <h2 class="font-display text-3xl md:text-4xl text-pale group-hover:text-safety transition-colors uppercase">
                  {servico.data.title}
                </h2>
                <svg class="w-6 h-6 text-steel group-hover:text-safety transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
                </svg>
              </div>

              <p class="text-pale/50 mb-6 flex-grow">{servico.data.description}</p>

              {servico.data.idealPara && (
                <div class="pt-6 border-t border-steel">
                  <p class="text-xs font-bold text-pale/70 uppercase tracking-wider mb-3">Ideal para:</p>
                  <div class="flex flex-wrap gap-2">
                    {servico.data.idealPara.map((item) => (
                      <span class="inline-block border border-steel px-3 py-1 text-sm text-pale/60">{item}</span>
                    ))}
                  </div>
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
