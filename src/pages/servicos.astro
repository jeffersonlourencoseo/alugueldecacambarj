---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';

const servicos = await getCollection('servicos');
---

<Layout
  title={`Aluguel de Caçamba de Entulho — 3m³, 5m³, 7m³ | ${SITE_CONFIG.name} RJ`}
  description="Aluguel de caçamba de entulho de 3m³, 5m³ e 7m³ no Rio de Janeiro. Locação com entrega rápida, retirada e documentação ambiental. Solicite orçamento grátis."
>
  <Header />

  <main>
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Serviços', href: '/servicos' },
      ]} />
    </div>

    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mb-16">
          <span class="inline-block rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-secondary mb-6">
            Nossos Serviços
          </span>

          <h1 class="text-4xl md:text-6xl font-black leading-tight text-gray-900 mb-6">
            Aluguel de Caçamba de Entulho no Rio de Janeiro
          </h1>

          <p class="text-lg text-gray-600">
            Escolha o tamanho ideal de caçamba de entulho para sua obra. Todos incluem entrega, retirada e documentação ambiental.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
          {servicos.map((servico) => (
            <a
              href={`/servicos/${servico.slug}`}
              class="group rounded-2xl bg-white p-10 md:p-12 border border-gray-100 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col"
            >
              <div class="flex items-start justify-between mb-6">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-secondary transition-colors">
                  {servico.data.title}
                </h2>
                <svg class="w-6 h-6 text-gray-400 group-hover:text-secondary transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>

              <p class="text-gray-600 mb-6 flex-grow">{servico.data.description}</p>

              {servico.data.idealPara && (
                <div class="pt-6 border-t border-gray-100">
                  <p class="text-sm font-semibold text-gray-500 mb-3">Ideal para:</p>
                  <div class="flex flex-wrap gap-2">
                    {servico.data.idealPara.map((item) => (
                      <span class="inline-block rounded-lg bg-gray-100 px-3 py-1 text-sm text-gray-700">{item}</span>
                    ))}
                  </div>
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
