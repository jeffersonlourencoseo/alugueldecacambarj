---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';

const posts = await getCollection('blog');
const postsOrdenados = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title={`Blog | Aluguel de Caçamba de Entulho no Rio — ${SITE_CONFIG.name}`}
  description="Dicas e guias sobre aluguel de caçamba de entulho no Rio de Janeiro. Aprenda a escolher, usar e descartar corretamente o entulho da sua obra."
>
  <Header />

  <main class="bg-concrete">
    <div class="container mx-auto px-6 md:px-12 pt-8">
      <Breadcrumb items={[
        { label: 'Início', href: '/' },
        { label: 'Blog', href: '/blog/' },
      ]} />
    </div>

    <section class="py-24 md:py-32">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mb-16">
          <div class="flex items-center gap-4 mb-6">
            <div class="h-px w-12 bg-safety"></div>
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-safety">Blog</span>
          </div>

          <h1 class="font-display text-5xl md:text-7xl text-pale uppercase leading-[0.95] mb-6">
            Dicas sobre
            <br />
            <span class="text-safety">Caçamba</span>
            no Rio
          </h1>

          <p class="text-lg text-pale/50">
            Conteúdo exclusivo para ajudar você a escolher, usar e descartar corretamente o entulho da sua obra.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {postsOrdenados.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group bg-concrete-light border border-steel p-10 md:p-12 hover:border-safety transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(245,197,24,0.15)] flex flex-col"
            >
              <div class="flex items-start justify-between mb-6">
                <span class="text-xs font-bold text-safety uppercase tracking-wider">
                  {post.data.pubDate.toLocaleDateString('pt-BR', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  })}
                </span>
                <svg class="w-6 h-6 text-steel group-hover:text-safety transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>

              <h2 class="font-display text-2xl md:text-3xl text-pale group-hover:text-safety transition-colors uppercase mb-4">
                {post.data.title}
              </h2>

              <p class="text-pale/50 flex-grow">{post.data.description}</p>

              <div class="pt-6 border-t border-steel mt-6">
                <span class="text-xs text-pale/40 uppercase tracking-wider">Por {post.data.author}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
